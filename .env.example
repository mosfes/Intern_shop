# Storefront: MockAPI project base URL (without /products or /categories)
MOCKAPI_BASE_URL=https://YOUR_PROJECT.mockapi.io/api/v1

# Public image origin; must match the image URLs in MockAPI
NEXT_PUBLIC_IMAGE_BASE_URL=https://YOUR_PUBLIC_BUCKET.r2.dev

# TiDB / MySQL connection for /api/health and /api/tasks
DATABASE_URL=mysql://USER:PASSWORD@HOST:4000/DATABASE
# DATABASE_SSL=true

# Only needed when running the R2 maintenance scripts
R2_ACCOUNT_ID=YOUR_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
R2_BUCKET=YOUR_BUCKET_NAME
