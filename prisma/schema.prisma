// Prisma schema — TiDB is MySQL-compatible, so we use the "mysql" provider.
// The connection URL lives in prisma.config.ts (Prisma 7+), not here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// NOTE: If your TiDB cluster does not support foreign keys (TiDB < 8.5),
// emulate relations in Prisma instead:  relationMode = "prisma"  (in datasource)
// and add @@index on every relation scalar field.

model Task {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(255)
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Only products created in this admin are stored here. MockAPI products are not imported.
model Brand {
  id       String    @id @default(cuid()) @db.VarChar(100)
  name     String    @unique @db.VarChar(100)
  logoUrl  String?   @db.VarChar(2048)
  products Product[]
}

model Category {
  id          String    @id @default(cuid()) @db.VarChar(100)
  slug        String    @unique @db.VarChar(180)
  name        String    @db.VarChar(255)
  nameTh      String    @db.VarChar(255)
  description String    @db.Text
  image       String    @db.VarChar(2048)
  products    Product[]
  specFields  CategorySpecField[]
}

// Default specification rows pre-filled in the product form for a category.
model CategorySpecField {
  id            String   @id @default(cuid()) @db.VarChar(100)
  categoryId    String   @db.VarChar(100)
  label         String   @db.VarChar(120)
  example       String   @default("") @db.VarChar(255)
  hint          String   @default("") @db.VarChar(500)
  compatibility Boolean  @default(false)
  powerAdvice   Boolean  @default(false)
  position      Int
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, position])
}

model Product {
  id             String                 @id @db.VarChar(100)
  slug           String                 @unique @db.VarChar(180)
  name           String                 @db.VarChar(255)
  brandId        String                 @db.VarChar(100)
  categoryId     String                 @db.VarChar(100)
  price          Decimal                @db.Decimal(12, 2)
  originalPrice  Decimal                @db.Decimal(12, 2)
  stock          Int                    @default(0)
  description    String                 @db.Text
  warranty       String                 @db.VarChar(255)
  rating         Float                  @default(0)
  reviewCount    Int                    @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  brand          Brand                  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category       Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images         ProductImage[]
  specifications ProductSpecification[]
  highlights     ProductHighlight[]
  shortSpecs     ProductShortSpec[]
  tags           ProductTag[]
  reviews        ProductReview[]

  @@index([brandId])
  @@index([categoryId])
  @@index([createdAt])
}

model ProductImage {
  id        String  @id @default(cuid()) @db.VarChar(100)
  productId String  @db.VarChar(100)
  url       String  @db.VarChar(2048)
  position  Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

enum ImageUploadState {
  PENDING
  ATTACHED
  DELETING
  DELETED
}

// Durable upload lifecycle, including abandoned drafts and deletion retries.
model ImageUpload {
  key       String           @id @db.VarChar(255)
  url       String           @db.VarChar(2048)
  ownerId   String?          @db.VarChar(191)
  draftId   String?          @db.VarChar(36)
  state     ImageUploadState @default(PENDING)
  expiresAt DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?
  attempts  Int              @default(0)
  lastError String?          @db.VarChar(255)

  @@index([state, expiresAt])
  @@index([ownerId, draftId, state])
}

model ProductSpecification {
  id            String  @id @default(cuid()) @db.VarChar(100)
  productId     String  @db.VarChar(100)
  label         String  @db.VarChar(120)
  value         String  @db.VarChar(1000)
  position      Int
  isHighlighted Boolean @default(false)
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

// Free-text highlights from any earlier TiDB records; selected specs use isHighlighted above.
model ProductHighlight {
  id        String  @id @default(cuid()) @db.VarChar(100)
  productId String  @db.VarChar(100)
  text      String  @db.VarChar(1000)
  position  Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductShortSpec {
  id        String  @id @default(cuid()) @db.VarChar(100)
  productId String  @db.VarChar(100)
  text      String  @db.VarChar(1000)
  position  Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductTag {
  productId String  @db.VarChar(100)
  tag       String  @db.VarChar(30)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, tag])
}

model ProductReview {
  id        String  @db.VarChar(100)
  productId String  @db.VarChar(100)
  author    String  @db.VarChar(255)
  rating    Float
  date      String  @db.VarChar(32)
  title     String  @db.VarChar(255)
  body      String  @db.Text
  verified  Boolean @default(false)
  position  Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, id])
  @@index([productId, position])
}

model AdminCredential {
  email        String   @id @db.VarChar(191)
  username     String?  @unique @db.VarChar(64)
  passwordHash String?  @db.VarChar(255)
  mustChangePassword Boolean @default(false)
  active       Boolean  @default(true)
  version      Int      @default(1)
  updatedAt    DateTime @updatedAt
}

model AdminLoginLimit {
  key       String   @id @db.VarChar(64)
  attempts  Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

model ShopUser {
  googleId  String   @id @db.VarChar(191)
  email     String   @unique @db.VarChar(191)
  name      String   @db.VarChar(255)
  phone     String   @default("") @db.VarChar(30)
  picture   String?  @db.Text
  disabled  Boolean  @default(false)
  createdAt DateTime @default(now())
  lastLogin DateTime @default(now())
}

// Signed-in shoppers' carts, so a cart follows the account across devices.
// productId is not a foreign key: products also come from MockAPI, not only this database.
model CartItem {
  userId    String   @db.VarChar(191)
  productId String   @db.VarChar(100)
  quantity  Int
  selected  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@id([userId, productId])
}

// A signed-in customer's saved delivery addresses, picked again on later orders.
// userId is ShopUser.googleId; not a foreign key, like CartItem.
model CustomerAddress {
  id        String   @id @default(cuid()) @db.VarChar(100)
  userId    String   @db.VarChar(191)
  label     String   @default("") @db.VarChar(60)
  fullName  String   @db.VarChar(255)
  phone     String   @db.VarChar(30)
  address   String   @db.VarChar(500)
  province  String   @db.VarChar(100)
  district  String   @db.VarChar(100)
  subdistrict String @default("") @db.VarChar(100)
  postcode  String   @db.VarChar(10)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

enum PromotionPlacement {
  HERO
  SIDE
  BANNER
}

// Homepage promotion slots managed in the admin (hero slider, side cards, promo banners).
model Promotion {
  id             String             @id @default(cuid()) @db.VarChar(100)
  placement      PromotionPlacement
  position       Int                @default(0)
  active         Boolean            @default(true)
  tag            String             @default("") @db.VarChar(60)
  eyebrow        String             @default("") @db.VarChar(120)
  title          String             @db.VarChar(160)
  highlight      String             @default("") @db.VarChar(120)
  description    String             @default("") @db.VarChar(500)
  image          String             @db.VarChar(2048)
  ctaLabel       String             @default("") @db.VarChar(60)
  ctaHref        String             @db.VarChar(500)
  secondaryLabel String             @default("") @db.VarChar(60)
  secondaryHref  String             @default("") @db.VarChar(500)
  theme          String             @default("light") @db.VarChar(10)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([placement, position])
}

// Checkout discount codes created by admins. type is "PERCENT" or "FIXED"; amounts are whole baht.
model DiscountCode {
  code        String    @id @db.VarChar(40)
  type        String    @db.VarChar(10)
  value       Int
  minSubtotal Int       @default(0)
  maxDiscount Int?
  usageLimit  Int?
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// A payment that was confirmed by Omise and has been settled (discount code counted). The primary key makes
// settling idempotent: the first caller to insert a chargeId wins, so a code is never counted twice.
model PaymentCharge {
  chargeId     String   @id @db.VarChar(100)
  userId       String   @db.VarChar(191)
  amount       Int
  discountCode String?  @db.VarChar(40)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

// Saved before contacting Omise so webhooks can finish checkout without a browser.
model CheckoutPayment {
  id        String   @id @db.VarChar(100)
  chargeId  String?  @unique @db.VarChar(100)
  userId    String   @db.VarChar(191)
  amount    Int
  status    String   @default("pending") @db.VarChar(20)
  order     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
}

// Independent snapshots preserve history after accounts or records are removed.
model AdminActivityLog {
  ipAddress     String? @db.VarChar(45)
  userAgent     String? @db.VarChar(1000)
  country       String? @db.VarChar(2)
  region        String? @db.VarChar(120)
  city          String? @db.VarChar(120)
  contextSource String? @db.VarChar(20)
  id         String   @id @default(cuid()) @db.VarChar(100)
  actorEmail String   @db.VarChar(191)
  actorName  String   @db.VarChar(255)
  resource   String   @db.VarChar(40)
  action     String   @db.VarChar(64)
  target     String   @db.VarChar(255)
  status     Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([createdAt, id])
  @@index([resource, createdAt])
}

// One schedule for the homepage Flash Sale. Null dates keep the daily Bangkok-midnight mode.
model FlashSaleSetting {
  id        String   @id @db.VarChar(40)
  enabled   Boolean  @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  updatedAt DateTime @updatedAt
}

// Product ids can refer to either TiDB or MockAPI, so there is no foreign key.
model FlashSaleItem {
  productId String   @id @db.VarChar(100)
  price     Decimal  @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt
}

// Transactional order emails, stored alongside the order update for safe retries.
model OrderEmail {
  id        String   @id @db.VarChar(191)
  recipient String   @db.VarChar(191)
  order     Json
  event     String   @db.VarChar(30)
  state     String   @default("pending") @db.VarChar(20)
  attempts  Int      @default(0)
  lockedAt  DateTime?
  sentAt    DateTime?
  createdAt DateTime @default(now())

  @@index([state, createdAt])
}

model CustomerCredential {
  email String @id @db.VarChar(191)
  passwordHash String @db.VarChar(255)
  version Int @default(1)
}

model PendingRegistration {
  email String @id @db.VarChar(191)
  name String @db.VarChar(255)
  phone String @db.VarChar(30)
  passwordHash String @db.VarChar(255)
  codeHash String @db.VarChar(64)
  attempts Int @default(0)
  expiresAt DateTime
}
