# Storefront: MockAPI project base URL (without /products or /categories)
MOCKAPI_BASE_URL=https://YOUR_PROJECT.mockapi.io/api/v1

# Public image origin for existing and uploaded product photos
NEXT_PUBLIC_IMAGE_BASE_URL=https://YOUR_PUBLIC_BUCKET.r2.dev

# TiDB / MySQL connection for new products, accounts, and sample APIs
DATABASE_URL=mysql://USER:PASSWORD@HOST:4000/DATABASE
# DATABASE_SSL=true

# Google sign-in: Web application OAuth client; no separate registration required.
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
# Use the production HTTPS origin and matching redirect URI when deploying.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Required for admin image uploads and R2 maintenance scripts (server only)
R2_ACCOUNT_ID=YOUR_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
R2_BUCKET=YOUR_BUCKET_NAME

# Omise (Opn Payments) — card, PromptPay and mobile banking. Use the TEST keys from the Omise dashboard while developing.
# Secret key stays on the server only; the public key is sent to the browser for card tokenisation (Omise.js).
OMISE_SECRET_KEY=skey_test_xxxxxxxxxxxxxxxxxxx
OMISE_PUBLIC_KEY=pkey_test_xxxxxxxxxxxxxxxxxxx
# Optional Base64 signing secret from Omise Webhooks Settings. When set, signatures are required.
# Without it the endpoint still independently verifies each charge through Omise's authenticated API.
OMISE_WEBHOOK_SECRET=

# Admin log client IP/location. Auto-enabled on Vercel (VERCEL=1).
# Set cloudflare ONLY if origin accepts traffic exclusively from Cloudflare;
# enable its "Add visitor location headers" transform for city/region.
# Set proxy for an origin protected by a reverse proxy that overwrites X-Real-IP.
# Set none to ignore all proxy headers. Local development normally has unknown IP/location.
ADMIN_LOG_PROXY=

# Order notification email (server only). Verify the sender domain in Resend first.
RESEND_API_KEY=
RESEND_FROM="EDM PC Shop <orders@edmpcshop-intern.mosapps.dev>"
# Secret used by the scheduled retry endpoint. Generate with: openssl rand -hex 32
CRON_SECRET=
