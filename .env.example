# Storefront: MockAPI project base URL (without /products or /categories)
MOCKAPI_BASE_URL=https://YOUR_PROJECT.mockapi.io/api/v1

# Public image origin for existing and uploaded product photos
NEXT_PUBLIC_IMAGE_BASE_URL=https://YOUR_PUBLIC_BUCKET.r2.dev

# TiDB / MySQL connection for new products, accounts, and sample APIs
DATABASE_URL=mysql://USER:PASSWORD@HOST:4000/DATABASE
# DATABASE_SSL=true

# Google sign-in: Web application OAuth client; no separate registration required.
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
# Use the production HTTPS origin and matching redirect URI when deploying.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Required for admin image uploads and R2 maintenance scripts (server only)
R2_ACCOUNT_ID=YOUR_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
R2_BUCKET=YOUR_BUCKET_NAME
